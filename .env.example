# ─────────────────────────────────────────────────────────────────────────────
# Órbita, configuração de ambiente
# Copie para .env e ajuste. O .env real nunca vai para o Git.
# Todos os valores abaixo são de DESENVOLVIMENTO e públicos por design.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modo de composição ───────────────────────────────────────────────────────
# monolith    = um processo só; o BFF fala com os serviços via ASGITransport
#               (sem rede). É o modo do free tier.
# distributed = cinco processos; o BFF fala com os serviços via HTTP real.
#               É o modo do docker-compose, equivalente ao desenho de produção.
HUB_MODE=distributed

# ── Banco ────────────────────────────────────────────────────────────────────
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://orbita:orbita_dev@postgres:5432/orbita
# Neon (produção/demo), inclua ?sslmode=require; o engine traduz para asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:senha@ep-xxx.sa-east-1.aws.neon.tech/orbita?sslmode=require

# ── Portas de adaptadores plugáveis ──────────────────────────────────────────
# BROKER_BACKEND:   postgres | rabbitmq
# EXECUTOR_BACKEND: simulated | subprocess | docker
# STORAGE_BACKEND:  postgres | s3
# LOCK_BACKEND:     postgres | redis
BROKER_BACKEND=rabbitmq
EXECUTOR_BACKEND=docker
STORAGE_BACKEND=s3
LOCK_BACKEND=redis

# ── RabbitMQ (apenas quando BROKER_BACKEND=rabbitmq) ─────────────────────────
RABBITMQ_URL=amqp://orbita:orbita_dev@rabbitmq:5672/
RABBITMQ_USER=orbita
RABBITMQ_PASSWORD=orbita_dev

# ── Redis (apenas quando LOCK_BACKEND=redis) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Armazenamento compativel com S3 (apenas quando STORAGE_BACKEND=s3) ──────
S3_ENDPOINT_URL=http://armazenamento:8333
# Endereco que o navegador alcanca, usado para assinar a URL de download.
# Dentro da rede do Docker o nome `armazenamento` nao existe fora dela.
S3_ENDPOINT_PUBLICO=http://localhost:8333
S3_ACCESS_KEY=orbita_admin
S3_SECRET_KEY=orbita_dev_password
S3_BUCKET=orbita-artefatos
S3_REGION=us-east-1

# ── Segurança ────────────────────────────────────────────────────────────────
# Gere os seus:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=desenvolvimento-apenas-troque-isto-por-48-bytes-aleatorios
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Segredo compartilhado dos callbacks internos (runner -> execution)
INTERNAL_SHARED_SECRET=desenvolvimento-apenas-troque-este-segredo-interno

# ── URLs internas (modo distributed) ─────────────────────────────────────────
IDENTITY_SERVICE_URL=http://identity:8001
CATALOG_SERVICE_URL=http://catalog:8002
EXECUTION_SERVICE_URL=http://execution:8003
RUNNER_SERVICE_URL=http://runner:8004

# ── Portal (Django BFF) ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=desenvolvimento-apenas-troque-esta-chave-por-50-chars-aleatorios
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_PORT=3000

# ── Demonstração pública ─────────────────────────────────────────────────────
# Habilita o botão "entrar como demonstração" que troca de papel sem senha.
# NUNCA ligue isto em um ambiente com dado real.
DEMO_MODE=true
